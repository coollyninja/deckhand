[Unit]
Description=Deckhand out-of-process WASM host (%i)
# The out-of-process WASM host (ADR-0005 Phase 4). It embeds gang-wasm-host and
# serves ONE signed WASM capability over the peer-authenticated Unix-socket host
# transport, so the component runs behind a double boundary: a separate UID (this
# unit) AND the WASM no-ambient-authority sandbox. Mutation-capable wasm plugins
# require it. Hardening is fail-closed with no topology; a private
# deckhand-site-<site> drop-in adds resolved egress CIDRs when a component needs
# outbound HTTPS (never in this public template).
After=network-online.target
Wants=network-online.target
Before=deckhand-broker.service deckhand-worker.service

[Service]
Type=exec
User=deckhand-%i
Group=deckhand
RuntimeDirectory=deckhand/plugins/%i
RuntimeDirectoryMode=0750
EnvironmentFile=/etc/deckhand/plugins/%i.runtime
ExecStart=/opt/deckhand/plugins/%i/current --socket-path /run/deckhand/plugins/%i/plugin.sock --broker-uid ${DECKHAND_BROKER_UID} --artifact-path /opt/deckhand/plugins/%i/component.wasm --data-dir /var/lib/deckhand/plugins/%i --robot ${DECKHAND_WASM_ROBOT} --capability ${DECKHAND_WASM_CAPABILITY}
UMask=0007

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

IPAddressDeny=any
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
TasksMax=64
LimitNOFILE=256
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
