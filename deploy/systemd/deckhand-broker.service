[Unit]
Description=Deckhand broker API
After=network-online.target deckhand-opa.service
Wants=network-online.target
Requires=deckhand-opa.service

[Service]
Type=exec
User=deckhand
Group=deckhand
WorkingDirectory=/opt/deckhand
ExecStart=/opt/deckhand/.venv/bin/deckhand-api
Environment=DECKHAND_BIND_HOST=127.0.0.1
Environment=DECKHAND_DATABASE_PATH=/var/lib/deckhand/deckhand.db
Environment=DECKHAND_CATALOG_PATH=/etc/deckhand/catalog
Environment=DECKHAND_PLUGIN_CONFIG_PATH=/etc/deckhand/plugins.yaml
Environment=DECKHAND_PLUGIN_LOCK_PATH=/etc/deckhand/plugins.lock.yaml
Environment=DECKHAND_PROXY_ASSERTION_FILE=%d/proxy-assertion
LoadCredential=proxy-assertion:/etc/deckhand/secrets/proxy-assertion
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/deckhand
UMask=0077
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=multi-user.target
