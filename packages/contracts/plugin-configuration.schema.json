{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckhand.invalid/schemas/plugin-configuration.schema.json",
  "title": "Deckhand plugin activation configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "object",
      "propertyNames": {"pattern": "^dh-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": {"type": "boolean", "default": true},
          "config": {"type": "object", "default": {}},
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": ["in_process", "sidecar", "wasm"],
                "default": "in_process"
              },
              "wasm": {
                "type": "object",
                "additionalProperties": false,
                "required": ["data_dir", "robot", "capability"],
                "properties": {
                  "gang_binary": {"type": "string", "maxLength": 256, "default": "gang"},
                  "data_dir": {"type": "string", "pattern": "^/"},
                  "robot": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
                  "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
                  "invoke_timeout_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 120,
                    "default": 20
                  },
                  "socket": {
                    "description": "Optional out-of-process transport. When present the plugin is reached over the ADR-0004 sidecar protocol to a deckhand-wasm-host process (double boundary: separate UID + WASM sandbox); mutation-capable wasm plugins require it. Absent, the broker embeds the runtime in-process (single boundary, dev/read-only only). Mirrors the sidecar connection shape.",
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "socket_path",
                      "expected_uid",
                      "artifact_path",
                      "signature_path",
                      "public_key_path"
                    ],
                    "properties": {
                      "socket_path": {"type": "string", "pattern": "^/"},
                      "socket_root": {
                        "type": "string",
                        "pattern": "^/",
                        "default": "/run/deckhand/plugins"
                      },
                      "expected_uid": {"type": "integer", "minimum": 0},
                      "artifact_path": {"type": "string", "pattern": "^/"},
                      "signature_path": {"type": "string", "pattern": "^/"},
                      "public_key_path": {"type": "string", "pattern": "^/"},
                      "trust_root": {
                        "type": "string",
                        "pattern": "^/",
                        "default": "/etc/deckhand/trust"
                      },
                      "trust_owner_uid": {
                        "type": "integer",
                        "minimum": 0,
                        "default": 0
                      },
                      "artifact_owner_uid": {
                        "type": "integer",
                        "minimum": 0,
                        "default": 0
                      },
                      "connect_timeout_seconds": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "maximum": 30,
                        "default": 2
                      },
                      "max_frame_bytes": {
                        "type": "integer",
                        "minimum": 4096,
                        "maximum": 4194304,
                        "default": 1048576
                      },
                      "max_artifact_bytes": {
                        "type": "integer",
                        "minimum": 1024,
                        "maximum": 1073741824,
                        "default": 134217728
                      }
                    }
                  }
                }
              },
              "sidecar": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "socket_path",
                  "expected_uid",
                  "artifact_path",
                  "signature_path",
                  "public_key_path"
                ],
                "properties": {
                  "socket_path": {"type": "string", "pattern": "^/"},
                  "socket_root": {
                    "type": "string",
                    "pattern": "^/",
                    "default": "/run/deckhand/plugins"
                  },
                  "expected_uid": {"type": "integer", "minimum": 0},
                  "artifact_path": {"type": "string", "pattern": "^/"},
                  "signature_path": {"type": "string", "pattern": "^/"},
                  "public_key_path": {"type": "string", "pattern": "^/"},
                  "trust_root": {
                    "type": "string",
                    "pattern": "^/",
                    "default": "/etc/deckhand/trust"
                  },
                  "trust_owner_uid": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  },
                  "artifact_owner_uid": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 0
                  },
                  "connect_timeout_seconds": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 30,
                    "default": 2
                  },
                  "max_frame_bytes": {
                    "type": "integer",
                    "minimum": 4096,
                    "maximum": 4194304,
                    "default": 1048576
                  },
                  "max_artifact_bytes": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 1073741824,
                    "default": 134217728
                  }
                }
              },
              "timeout_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300,
                "default": 10
              },
              "max_concurrency": {
                "type": "integer",
                "minimum": 1,
                "maximum": 256,
                "default": 8
              },
              "requests_per_second": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 10000,
                "default": 20
              },
              "burst": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000,
                "default": 20
              },
              "failure_threshold": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100,
                "default": 5
              },
              "recovery_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 3600,
                "default": 30
              }
            },
            "allOf": [
              {
                "if": {
                  "required": ["mode"],
                  "properties": {"mode": {"const": "sidecar"}}
                },
                "then": {"required": ["sidecar"]}
              },
              {
                "if": {
                  "required": ["mode"],
                  "properties": {"mode": {"const": "in_process"}}
                },
                "then": {"not": {"required": ["sidecar", "wasm"]}}
              },
              {
                "if": {
                  "required": ["mode"],
                  "properties": {"mode": {"const": "wasm"}}
                },
                "then": {"required": ["wasm"]}
              }
            ]
          }
        }
      }
    }
  }
}
