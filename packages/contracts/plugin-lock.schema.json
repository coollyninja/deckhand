{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckhand.invalid/schemas/plugin-lock.schema.json",
  "title": "Deckhand plugin lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plugins"],
  "properties": {
    "schema_version": {"const": 1},
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "source"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^dh-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
          },
          "source": {"enum": ["builtin", "python", "sidecar"]},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        },
        "allOf": [
          {
            "if": {"properties": {"source": {"const": "sidecar"}}},
            "then": {"required": ["digest"]}
          }
        ]
      }
    }
  }
}
