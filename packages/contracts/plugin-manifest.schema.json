{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckhand.invalid/schemas/plugin-manifest.schema.json",
  "title": "Deckhand plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "api_version",
    "description",
    "adapters",
    "status_provider_types",
    "actions",
    "permissions",
    "config_schema"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^dh-[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
    },
    "api_version": {"const": 1},
    "description": {"type": "string", "minLength": 1, "maxLength": 1024},
    "adapters": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "status_provider_types": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mutation", "credential_slots", "egress_bindings"],
      "properties": {
        "mutation": {"type": "boolean"},
        "credential_slots": {"type": "array", "items": {"type": "string"}},
        "egress_bindings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "config_schema": {"type": "object"}
  }
}
