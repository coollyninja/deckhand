{
  "id": "pve.vm.ensure_running",
  "version": 1,
  "title": "Ensure VM running",
  "description": "Start an allowlisted Proxmox VM if needed and verify guest state.",
  "risk_class": "reversible",
  "adapter": "proxmox",
  "target_types": ["pve_vm"],
  "parameter_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "wait_for_guest_agent": {"type": "boolean", "default": true}
    }
  },
  "policy_action": "pve.vm.power",
  "confirmation": "confirm",
  "timeout_seconds": 120,
  "idempotency": "ensure-state",
  "mutation": true
}
